# Example backend environment variables
PORT=5000
MONGODB_URI=mongodb://localhost:27017/rfid-inventory
JWT_SECRET=change_this_to_a_secure_value
USE_CHANGE_STREAMS=false
ALLOWED_ORIGINS=http://localhost:3000

# Optional SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RFID System <no-reply@example.com>
