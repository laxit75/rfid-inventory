# Required application settings
PORT=5000
MONGODB_URI=mongodb://localhost:27017/rfid-inventory
JWT_SECRET=replace-with-a-long-random-secret
USE_CHANGE_STREAMS=false
ALLOWED_ORIGINS=http://localhost:3000
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RFID_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
MARKTRACE_LISTEN_HOST=0.0.0.0  # Host/interface to bind the incoming Marktrace TCP listener
MARKTRACE_LISTEN_PORT=4600      # Port for the Marktrace reader to connect to
DEBUG_RAW_FRAMES=false          # Enable raw frame hex/ascii logging and JSONL capture for protocol analysis
BUZZER_CONTROLLER_URL=http://buzzer-controller.local  # Optional buzzer controller base URL
LOGIN_LIMIT_WINDOW_MS=900000    # Rate limit window for login attempts (ms)
LOGIN_LIMIT_MAX=10              # Max login attempts within the window

# SMTP settings
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NODE_ENV=development
SMTP_FROM="RFID System <no-reply@example.com>"

# Required only when running the seed script
SEED_ADMIN_PASSWORD=replace-admin-password
SEED_USER_PASSWORD=replace-user-password
