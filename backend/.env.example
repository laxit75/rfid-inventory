# ─── Required ───────────────────────────────────────────────
# MongoDB connection string (required)
MONGODB_URI=mongodb://localhost:27017/rfid-inventory

# JWT signing secret - generate with: openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-secret

# Shared secret for RFID hardware webhook (POST /api/rfid/*)
RFID_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# ─── Server ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated allowed CORS origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000

# ─── Realtime ───────────────────────────────────────────────
# Set to 'true' to use MongoDB Change Streams (requires replica set)
USE_CHANGE_STREAMS=false

# ─── RabbitMQ (for email delivery) ───────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ─── SMTP ───────────────────────────────────────────────────
# Leave SMTP_USER/PASS empty to use Ethereal test account in dev
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RFID System <no-reply@example.com>"

# ─── Marktrace Reader ───────────────────────────────────────
MARKTRACE_LISTEN_HOST=0.0.0.0
MARKTRACE_LISTEN_PORT=4600
DEBUG_RAW_FRAMES=false
BUZZER_CONTROLLER_URL=

# ─── Rate Limiting ──────────────────────────────────────────
LOGIN_LIMIT_WINDOW_MS=900000
LOGIN_LIMIT_MAX=10

# ─── Seeding (required only when running seed.js) ───────────
SEED_ADMIN_PASSWORD=change-me-admin
SEED_USER_PASSWORD=change-me-user
