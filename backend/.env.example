# Required application settings
PORT=5000
MONGODB_URI=mongodb://localhost:27017/rfid-inventory
JWT_SECRET=replace-with-a-long-random-secret
USE_CHANGE_STREAMS=false
ALLOWED_ORIGINS=http://localhost:3000
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RFID_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# SMTP settings
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NODE_ENV=development
SMTP_FROM="RFID System <no-reply@example.com>"

# Required only when running the seed script
SEED_ADMIN_PASSWORD=replace-admin-password
SEED_USER_PASSWORD=replace-user-password
